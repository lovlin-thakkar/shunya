DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

DB_NAME=zenapi
DB_USER=zen
DB_PASSWORD=zen
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Service token — shared secret for pipecat → django internal calls.
# Must match DJANGO_SERVICE_TOKEN in services/voice/.env.
SERVICE_TOKEN=dev-service-token-change-me

# CORS origin for the local UI (Next.js dev server)
UI_URL=http://localhost:3000

# Voice QA — LLM + audio services
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DAILY_API_KEY=

# Pipecat agent server (docker-compose overrides to http://pipecat:8001)
PIPECAT_SERVER_URL=http://localhost:8001

# Recordings directory (docker-compose overrides to /recordings)
RECORDINGS_DIR=/recordings
