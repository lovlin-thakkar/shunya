DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Local dev only. Leave UNSET (or 0) in production — DEBUG defaults to off, which
# enforces the dev-secret guards and a non-wildcard ALLOWED_HOSTS.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is not 1 (comma-separated hostnames).
# ALLOWED_HOSTS=api.example.com

DB_NAME=zenapi
DB_USER=zen
DB_PASSWORD=zen
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Service token — shared secret for caller service → django internal calls.
# Must match DJANGO_SERVICE_TOKEN in services/voice/.env.
SERVICE_TOKEN=dev-service-token-change-me

# CORS origin for the local UI (Next.js dev server)
UI_URL=http://localhost:3000

# LLM + audio services
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=        # remote mode: ElevenLabs ConvAI + TTS for synthetic caller
DAILY_API_KEY=             # remote mode: Daily.co WebRTC (live listen-in)

# Caller service (docker-compose overrides to http://caller:8002)
CALLER_SERVER_URL=http://localhost:8002

# Recordings directory (docker-compose overrides to /recordings)
RECORDINGS_DIR=/recordings
