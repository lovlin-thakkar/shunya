ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
DAILY_API_KEY=

# Django API URL (docker-compose overrides to http://django:8000)
DJANGO_API_URL=http://localhost:8000

# Service token — must match SERVICE_TOKEN in apps/api/.env
DJANGO_SERVICE_TOKEN=dev-service-token-change-me

# Tenant ID for the active tenant (integer PK from multitenant_tenant table)
# Run: uv run python manage.py shell -c "from zenlib.reusable_apps.multitenant.models import Tenant; print(Tenant.objects.first().id)"
DJANGO_TENANT_ID=1
